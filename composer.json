{
    "name": "regionally-famous/fleet-for-openstation",
    "description": "Development tools for Fleet for OpenStation.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "1.2.1",
        "phpcompatibility/phpcompatibility-wp": "2.1.8",
        "phpstan/phpstan": "2.2.12",
        "szepeviktor/phpstan-wordpress": "2.0.4",
        "wp-coding-standards/wpcs": "3.4.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "quality": "./bin/check-quality.sh"
    }
}
